{
  "name": "as-nestjs",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "users"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "start": "bun run --filter '*' start",
    "start:dev": "bun run --filter '*' start:dev",
    "start:prod": "bun run --filter '*' start:prod",
    "lint:shared": "eslint \"libs/**/*.ts\"",
    "lint:shared:fix": "eslint \"libs/**/*.ts\" --fix",
    "lint": "bun run lint:shared && bun run --filter '*' lint",
    "lint:fix": "bun run lint:shared:fix && bun run --filter '*' lint:fix",
    "format:shared": "prettier --check \"libs/**/*.ts\"",
    "format:shared:fix": "prettier --write \"libs/**/*.ts\"",
    "format": "bun run format:shared && bun run --filter '*' format",
    "format:fix": "bun run format:shared:fix && bun run --filter '*' format:fix",
    "typecheck": "bun run --filter '*' typecheck",
    "validate": "bun run lint && bun run typecheck",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun run --filter '*' test:e2e",
    "migration:run": "bun run --filter '*' migration:run"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.0.0",
    "knip": "^6.35.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0"
  }
}
