{
  "name": "users",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/users/src/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --config ../eslint.config.mts",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --config ../eslint.config.mts --fix",
    "format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "bun run lint && bun run typecheck",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:generate": "sh -c 'typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts \"src/database/migrations/$1\"' --",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "~11.0.12",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "11.0.3",
    "argon2": "^0.45.1",
    "cache-manager": "^7.2.9",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.13",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tlds": "^1.261.0",
    "typeorm": "^1.1.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.0.0",
    "@types/validator": "^13.15.10",
    "jest": "^30.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@users/(.*)$": "<rootDir>/$1",
      "^@app/shared$": "<rootDir>/../../libs/shared/src",
      "^@app/shared/(.*)$": "<rootDir>/../../libs/shared/src/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!.*(@nestjs/cache-manager|@nestjs/config|@nestjs/jwt|@nestjs/mapped-types|@nestjs/passport|cache-manager)(/|$))"
    ]
  }
}
